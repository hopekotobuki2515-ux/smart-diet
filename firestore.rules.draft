// Release candidate. Verify against the active production rules before publishing.
// Provision coachAssignments/{clientUid} from a trusted administrator, never the client app.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{collection}/{document=**} {
        allow read, write: if isOwner(userId) && collection != 'appData';
      }

      match /appData/{app}/{document=**} {
        allow read, write: if isOwner(userId) && app != 'hopeProgram';
      }
    }

    match /users/{clientUid}/appData/hopeProgram {
      allow get: if isOwner(clientUid)
        || (request.auth != null
          && exists(/databases/$(database)/documents/coachAssignments/$(clientUid))
          && get(/databases/$(database)/documents/coachAssignments/$(clientUid)).data.coachUid == request.auth.uid);
      allow create: if isOwner(clientUid)
        && exists(/databases/$(database)/documents/programAdmissions/$(clientUid));
      allow update, delete: if isOwner(clientUid);
    }

    // An operator creates programInvites/{sha256Hex} with active: true.
    // There is no client read or write access to the invite collection.
    match /programAdmissions/{userId} {
      function activeInvite(digest) {
        return digest is string && digest.matches('^[a-f0-9]{64}$')
          && get(/databases/$(database)/documents/programInvites/$(digest)).data.active == true;
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['digest'])
        && activeInvite(request.resource.data.digest);
    }

    // Example assignment: { coachUid: "<verified Firebase Auth UID>" }.
    // Clients cannot add themselves or change their assigned coach.
    match /coachAssignments/{clientUid} {
      allow get, list: if request.auth != null && resource.data.coachUid == request.auth.uid;
      allow write: if false;
    }

    match /coachComments/{clientUid}/weeks/{weekId} {
      function assignedCoach() {
        return request.auth != null
          && exists(/databases/$(database)/documents/coachAssignments/$(clientUid))
          && get(/databases/$(database)/documents/coachAssignments/$(clientUid)).data.coachUid == request.auth.uid;
      }

      function validComment() {
        return request.resource.data.keys().hasAll(['message', 'status', 'authorUid', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['message', 'status', 'authorUid', 'updatedAt'])
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 1500
          && request.resource.data.status in ['draft', 'published']
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.updatedAt is timestamp;
      }

      // A client sees only a published comment for their own UID.
      allow get: if (request.auth != null
            && request.auth.uid == clientUid
            && resource.data.status == 'published')
          || assignedCoach();
      allow list: if false;
      allow create, update: if assignedCoach() && validComment();
      allow delete: if false;
    }
  }
}
